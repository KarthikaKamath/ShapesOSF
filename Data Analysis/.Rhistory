)
# Import the necessary libraries
library(readxl)
library(tidyverse)
library(rstatix)
library(ggforce)
library(ggpubr)
library(patchwork)
exp <- 'E1'
#for plotting purpose
if (exp == "E1") {
levels_labels <- c(
"object",
"equilateral_triangle",
"isosceles_triangle",
"square",
"rhombus",
"pentagon"
)
}
# Construct the paths
path_data_processed <- file.path(getwd(), paste0("data/processed_", exp))
path_wd <- file.path(getwd())
setwd(path_data_processed)
load(sprintf("data_output_step02_%s.RData", exp))
str(data_output_step02)
data_output_step02 <- data_output_step02 %>%
mutate(shape_w_duck_car = shape) %>%
mutate(shape = ifelse(shape %in% c('duck','car'),'object',shape))
aux_prop_look_dev <- data_output_step02 %>%
filter(event %in% c('shapes_on_1','shapes_on_2')) %>%
group_by(participantid,ppt_included,block,trialnumber_withinblock,shape,gaze,
location_deviant,deviant_type,
orientation,
validtrial,sumvalidtrials_overall,
proponscreen_shapes_on_1,proponscreen_shapes_on_2,shape_w_duck_car) %>%
count() %>%
pivot_wider(names_from = gaze, values_from = n, values_fill = 0, names_glue = "gaze_{gaze}")%>%
mutate(total_dwell_shapes = gaze_topleft_1 + gaze_topright_2 + gaze_bottomleft_3 + gaze_bottomright_4) %>%
mutate(total_dwell_deviant = case_when(
location_deviant == 1 ~ gaze_topleft_1,
location_deviant == 2 ~ gaze_topright_2,
location_deviant == 3 ~ gaze_bottomleft_3,
location_deviant == 4 ~ gaze_bottomright_4)) %>%
mutate(prop_look_dev = (total_dwell_deviant/total_dwell_shapes))
aux_prop_look_dev_by_event <- data_output_step02 %>%
filter(event %in% c('shapes_on_1','shapes_on_2')) %>%
group_by(participantid,ppt_included,block,trialnumber_withinblock,shape,gaze,location_deviant,deviant_type,orientation,
validtrial,sumvalidtrials_overall,event,
proponscreen_shapes_on_1,proponscreen_shapes_on_2,shape_w_duck_car) %>%
count() %>%
pivot_wider(names_from = gaze, values_from = n, values_fill = 0, names_glue = "gaze_{gaze}")%>%
mutate(total_dwell_shapes = gaze_topleft_1 + gaze_topright_2 + gaze_bottomleft_3 + gaze_bottomright_4) %>%
mutate(total_dwell_deviant = case_when(
location_deviant == 1 ~ gaze_topleft_1,
location_deviant == 2 ~ gaze_topright_2,
location_deviant == 3 ~ gaze_bottomleft_3,
location_deviant == 4 ~ gaze_bottomright_4)) %>%
mutate(prop_look_dev = (total_dwell_deviant/total_dwell_shapes))
aux_prop_look_dev_group <- aux_prop_look_dev %>%
filter(validtrial == 1) %>%
filter(ppt_included == 1) %>%
group_by(participantid,shape) %>%
summarise(m_prop_look_dev = mean(prop_look_dev, na.rm = T))
aux_prop_look_dev_group_by_block <- aux_prop_look_dev %>%
filter(validtrial == 1) %>%
filter(ppt_included == 1) %>%
group_by(participantid,shape,block) %>%
summarise(m_prop_look_dev = mean(prop_look_dev, na.rm = T))
aux_prop_look_dev_group_by_event <- aux_prop_look_dev_by_event %>%
filter(validtrial == 1) %>%
filter(ppt_included == 1) %>%
group_by(participantid,shape,event) %>%
summarise(m_prop_look_dev = mean(prop_look_dev, na.rm = T))
aux_prop_look_dev_group %>%
filter(shape == 'square') %>%
filter(m_prop_look_dev < .25)
aux_prop_look_dev_group %>%
filter(shape == 'square') %>%
filter(m_prop_look_dev >= .25)
aux_prop_look_dev_group %>%
mutate(shape = factor(shape, levels = levels_labels)) %>%
filter(shape != "object") %>%
ggplot(aes(y = m_prop_look_dev, x = shape, color = shape)) +
geom_boxplot() +
geom_point(position=position_dodge(width=.1)) +
geom_hline(yintercept = 0.25, linetype = "dashed", color = "gray40") +
stat_summary(fun = mean, geom = "point", size = 4, color = "tomato") +
theme(axis.text.x = element_text(angle = 45, hjust=1)) +
ylim(0,0.6)
p_event <- aux_prop_look_dev_group_by_event %>%
mutate(shape = factor(shape, levels = levels_labels)) %>%
ggplot(aes(y = m_prop_look_dev, x = shape, color = shape)) +
geom_boxplot() +
geom_point(position=position_dodge(width=.1)) +
geom_hline(yintercept = 0.25, linetype = "dashed", color = "gray40") +
stat_summary(fun = mean, geom = "point", size = 4, color = "tomato") +
theme(legend.position = "none",axis.text.x = element_text(angle = 45, hjust=1)) +
facet_wrap(. ~ event)
p_individual_blocks <- aux_prop_look_dev_group_by_block %>%
mutate(shape = factor(shape, levels = levels_labels)) %>%
ggplot(aes(y = m_prop_look_dev, x = shape, color = shape)) +
geom_boxplot() +
geom_point(position=position_dodge(width=.1)) +
geom_hline(yintercept = 0.25, linetype = "dashed", color = "gray40") +
stat_summary(fun = mean, geom = "point", size = 4, color = "tomato") +
theme(legend.position = "none",axis.text.x = element_text(angle = 45, hjust=1)) +
facet_wrap(. ~ block)
p_individual_blocks
p_block <- aux_prop_look_dev_group_by_block %>%
mutate(shape = factor(shape, levels = levels_labels)) %>%
mutate(block_group = case_when(
block %in% c(1, 2) ~ "Blocks 1-2",
block %in% c(3, 4) ~ "Blocks 3-4"
)) %>%
ggplot(aes(y = m_prop_look_dev, x = shape, color = shape)) +
geom_boxplot(outlier.shape = NA) +
geom_point(position=position_dodge(width=.1), size=0.75) +
geom_hline(yintercept = 0.25, linetype = "dashed", color = "gray40") +
stat_summary(fun = mean, geom = "point", size = 1.8, color = "tomato") +
theme(legend.position = "none",axis.text.x = element_text(angle = 45, hjust=1)) +
facet_wrap(. ~ block_group)
ggarrange(
p_event, p_block,
ncol = 1, nrow = 2, labels = c("A", "B")
)
aux_prop_look_dev %>%
filter(ppt_included == 1) %>%
filter(validtrial == 1) %>%
mutate(shape = factor(shape, levels = levels_labels)) %>%
ggplot(aes(y = prop_look_dev, x = shape, color = shape)) +
geom_boxplot() +
geom_point(position=position_dodge(width=.1)) +
geom_hline(yintercept = 0.25, linetype = "dashed", color = "gray40") +
stat_summary(fun = mean, geom = "point", size = 3, color = "tomato") +
facet_wrap_paginate(~ participantid, ncol = 2, nrow = 2, page = 1) +  # shows 4 participants per page
theme(axis.text.x = element_text(angle = 45, hjust=1)) +
facet_wrap(. ~ participantid)
aux_prop_look_dev %>%
filter(ppt_included == 1) %>%
filter(validtrial == 1) %>%
filter(shape != "object") %>%
mutate(shape = factor(shape, levels = levels_labels)) %>%
ggplot(aes(y = prop_look_dev, x = shape, color = shape)) +
#geom_boxplot() +
#geom_point(position=position_dodge(width=.1)) +
geom_hline(yintercept = 0.25, linetype = "dashed", color = "gray40") +
stat_summary(fun = mean, geom = "point", size = 3, aes(color = shape)) +
stat_summary(fun = mean, geom = "line", aes(group = 1), size = 1, color = "gray") +
facet_wrap_paginate(~ participantid, ncol = 2, nrow = 2, page = 1) +  # shows 4 participants per page
theme(legend.position = "none",axis.text.x = element_text(angle = 45, hjust=1)) +
facet_wrap(. ~ participantid)
aux_prop_look_dev %>%
filter(ppt_included == 1, validtrial == 1) %>%
filter(shape != "object") %>%
mutate(shape = factor(shape, levels = levels_labels)) %>%
ggplot(aes(x = shape, y = prop_look_dev, group = participantid)) +
geom_hline(yintercept = 0.25, linetype = "dashed", color = "gray40") +
stat_summary(fun = mean, geom = "line", aes(group = participantid), color = "gray70", size = 0.5) +
stat_summary(fun = mean, geom = "line", aes(group = 1), color = "tomato", size = 1.5) + # group mean
# add mean points per shape (group mean)
stat_summary(fun = mean, geom = "point", size = 3, aes(color = shape)) +
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(y = "Proportion looking at the deviant", x = "Shape")
aux_prop_look_dev_group %>%
group_by(shape) %>%
get_summary_stats(m_prop_look_dev, type = "mean_sd")
aux_prop_look_dev_group %>%
group_by(shape) %>%
shapiro_test(m_prop_look_dev)
aux_prop_look_dev_group %>%
group_by(shape) %>%
t_test(m_prop_look_dev ~ 1, mu = .25)
aux <- aux_prop_look_dev_group %>%
filter(!shape %in% c('car', 'duck')) %>%
convert_as_factor(participantid, shape) %>%
ungroup()
auxcheck <- aux %>%
pivot_wider(values_from = m_prop_look_dev, names_from = 'shape')
aux %>%
pairwise_t_test(m_prop_look_dev ~ shape,
subject = "participantid",
paired = TRUE, p.adjust.method = "bonferroni")
res.aov <- anova_test(
data = aux, dv = m_prop_look_dev, wid = participantid,
within = c(shape)
)
res.aov
aux_prop_look_dev_condition <- aux_prop_look_dev %>%
filter(validtrial == 1, ppt_included == 1) %>%
group_by(participantid, shape, deviant_type, orientation, location_deviant) %>%
summarise(m_prop_look_dev = mean(prop_look_dev, na.rm = TRUE),
.groups = "drop")
# Mean ± SD by shape
aux_prop_look_dev_condition %>%
group_by(shape) %>%
get_summary_stats(m_prop_look_dev, type = "mean_sd")
# Mean ± SD by deviant_type
aux_prop_look_dev_condition %>%
group_by(shape,deviant_type) %>%
get_summary_stats(m_prop_look_dev, type = "mean_sd")
# Mean ± SD by orientation
aux_prop_look_dev_condition %>%
group_by(shape,orientation) %>%
get_summary_stats(m_prop_look_dev, type = "mean_sd")
# Mean ± SD by deviant location
aux_prop_look_dev_condition %>%
group_by(shape,location_deviant) %>%
get_summary_stats(m_prop_look_dev, type = "mean_sd")
# By deviant_type
anova_deviant_type <- aux_prop_look_dev_condition %>%
group_by(shape) %>%
anova_test(m_prop_look_dev ~ deviant_type)
anova_deviant_type %>% get_anova_table()
# By orientation
anova_orientation <- aux_prop_look_dev_condition %>%
group_by(shape) %>%
anova_test(m_prop_look_dev ~ orientation)
anova_orientation %>% get_anova_table()
# By location_deviant
anova_location <- aux_prop_look_dev_condition %>%
group_by(shape) %>%
anova_test(m_prop_look_dev ~ location_deviant)
anova_location %>% get_anova_table()
anova_full <- aux_prop_look_dev_condition %>%
filter(!participantid == 136) %>%
anova_test(m_prop_look_dev ~ shape * deviant_type * orientation * location_deviant)
get_anova_table(anova_full)
setwd(path_data_processed)
write.csv(aux_prop_look_dev, file = "data_output_step05_individual_summary.csv", row.names = FALSE)
setwd(path_data_processed)
write.csv(aux_prop_look_dev_group, file = "data_output_step05_group_summary.csv", row.names = FALSE)
# Import the necessary libraries
library(readxl)
library(tidyverse)
library(rstatix)
library(ggforce)
exp <- 'E1'
#for plotting purpose
if (exp == "E1") {
levels_labels <- c(
"object",
"equilateral_triangle",
"isosceles_triangle",
"square",
"rhombus",
"pentagon"
)
}
# Construct the paths
path_data_processed <- file.path(getwd(), paste0("data/processed_", exp))
path_wd <- file.path(getwd())
setwd(path_data_processed)
load(sprintf("data_output_step02_%s.RData", exp))
data_output_step02 <- data_output_step02 %>%
mutate(shape_w_duck_car = shape) %>%
mutate(shape = ifelse(shape %in% c('duck','car'),'object',shape))
#for plotting purpose
desired_shape_order <- levels_labels
data_output_step02 <- data_output_step02 %>%
mutate(shape = factor(shape, levels = desired_shape_order))
aux <- data_output_step02 %>%
filter(validtrial == 1) %>%
filter(ppt_included == 1) %>%
filter(event %in% c("shapes_on_1", "shapes_on_2")) %>%
mutate(
gaze_quadrant = as.numeric(str_extract(gaze, "\\d"))
)
data_time_course <- aux %>%
mutate(gaze_is_on_deviant = case_when(
#gaze %in% c("offscreen", "nogaze") ~ NaN,
gaze_quadrant == location_deviant ~ 1,
gaze_quadrant %in% c(location_standard, location_standard_smaller, location_standard_larger) ~ 0  # standard
)) %>%
mutate(gaze_stim = case_when(
gaze == "centre" ~ "centre",
gaze_quadrant == location_deviant ~ "deviant",
gaze_quadrant %in% c(location_standard, location_standard_smaller, location_standard_larger) ~ gaze  # standard
))
#within subject average
timecourse_within_subject <- data_time_course %>%
filter(!is.na(gaze_is_on_deviant)) %>%
group_by(
participantid,
event,
shape,
samplecount_trial
) %>%
summarise(
pld_within_subj = mean(gaze_is_on_deviant, na.rm = TRUE),
.groups = "drop"
)
#grand average
timecourse_group <- timecourse_within_subject %>%
group_by(
event,
shape,
samplecount_trial
) %>%
summarise(
mean_pld = mean(pld_within_subj, na.rm = TRUE),
se_pld = sd(pld_within_subj, na.rm = TRUE) / sqrt(n()),
n = n(),
.groups = "drop"
)
p_withoutbinning<-ggplot(timecourse_group,
aes(x = samplecount_trial, y = mean_pld, color = shape, fill = shape)) +
geom_line() +
geom_ribbon(aes(ymin = mean_pld - se_pld,
ymax = mean_pld + se_pld),
alpha = 0.2, color = NA) +
geom_hline(yintercept = 0.25, linetype = "dashed") +
facet_grid(shape ~ event) +
ylim(0, 0.75) +
theme_classic() +
labs(
#title = "Timecourse of proportion looking at deviant across participants",
subtitle = "X axis not binned",
x = "Time (samples)",
y = "Proportion looking at deviant"
)+
theme(
legend.position = "none")
p_withoutbinning
bin_width <- 5 #controls the smoothing of the graph
data_binned <- data_time_course %>%
filter(
validtrial == 1,
ppt_included == 1,
event %in% c("shapes_on_1", "shapes_on_2")
) %>%
mutate(
time_bin = ceiling(samplecount_trial / bin_width)
)
pld_trial_bin <- data_binned %>%
group_by(
participantid, shape, event, block,
trialnumber_withinblock, time_bin
) %>%
summarise(
pld_bin = mean(gaze_is_on_deviant, na.rm = TRUE),
.groups = "drop"
)
pld_participant <- pld_trial_bin %>%
group_by(participantid, shape, event, time_bin) %>%
summarise(
pld_participant = mean(pld_bin, na.rm = TRUE),
.groups = "drop"
)
#split by block
pld_participant_block <- pld_trial_bin %>%
group_by(participantid, shape, block, event, time_bin) %>%
summarise(
pld_participant = mean(pld_bin, na.rm = TRUE),
.groups = "drop"
)
pld_group <- pld_participant %>%
group_by(shape, event, time_bin) %>%
summarise(
mean_pld = mean(pld_participant, na.rm = TRUE),
se_pld   = sd(pld_participant, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
)
pld_group_block <- pld_participant_block %>%
group_by(shape, block, event, time_bin) %>%
summarise(
mean_pld = mean(pld_participant, na.rm = TRUE),
se_pld   = sd(pld_participant, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
)
p_withbinning <- ggplot(pld_group,
aes(x = time_bin * bin_width, y = mean_pld, color = shape, fill = shape)) +
geom_hline(yintercept = 0.25, linetype = "dashed") +
geom_ribbon(
aes(ymin = mean_pld - se_pld, ymax = mean_pld + se_pld),
alpha = 0.2, color = NA
) +
geom_line() +
facet_grid(shape ~ event) +
ylim(0, 0.75) +
labs(
subtitle = "X axis samples binned with bin length = 5",
x = "Time (samples)",
y = "Proportion looking at deviant")+
theme_classic()+
theme(
legend.position = "none")
p_withbinning
combined_timecourse <- ggarrange(
p_withoutbinning,
p_withbinning,
ncol = 2, nrow = 1,
labels = c("A", "B")
)
final_timecourse_figure <- annotate_figure(
combined_timecourse,
top = text_grob(
"Timecourse of proportion looking at deviant across participants",
face = "bold",
size = 14
)
)
final_timecourse_figure
ggsave(
filename = "intruder_step006_timecourse.png",
plot = final_timecourse_figure,
width = 18,       # in inches
height = 12,       # adjust as needed
dpi = 300         # publication quality
)
#options(bitmapType = "cairo")
p_withbin_splitblock <- ggplot(pld_group_block,
aes(x = time_bin * bin_width,
y = mean_pld,
color = shape,
fill = shape)) +
geom_hline(yintercept = 0.25,
linetype = "dashed",
color = "gray40") +
geom_ribbon(
aes(ymin = mean_pld - se_pld,
ymax = mean_pld + se_pld),
alpha = 0.2,
color = NA
) +
geom_line(size = 1) +
facet_grid(event + shape ~ block) +
scale_x_continuous(
limits = c(0, 120),
expand = c(0, 0)
) +
scale_y_continuous(limits = c(0, 0.75)) +
theme_classic(base_size = 15) +
labs(
title = "Time course of proportion looking to the deviant",
subtitle = "Averaged across participants; split by block; Bin length = 5 samples",
x = "Time (samples)",
y = "Proportion looking to deviant",
color = "Shape",
fill = "Shape"
) +
theme(
legend.position = "none")
p_withbin_splitblock
